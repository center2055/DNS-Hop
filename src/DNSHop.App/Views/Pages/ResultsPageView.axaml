<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l10n="using:DNSHop.App.Localization"
             xmlns:vm="using:DNSHop.App.ViewModels.Pages"
             xmlns:models="using:DNSHop.App.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="DNSHop.App.Views.Pages.ResultsPageView"
             x:DataType="vm:ResultsPageViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="800">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BarCachedBrush" Color="#E0573E" />
    <SolidColorBrush x:Key="BarUncachedBrush" Color="#2FB344" />
    <SolidColorBrush x:Key="BarDotComBrush" Color="#3B82F6" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Hover effect on a result row: lift the surface and brighten its bars. -->
    <Style Selector="Border.ResultRow">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ResultRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.ResultRow Border.MetricBar">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.ResultRow:pointerover Border.MetricBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                AllowAutoHide="False">
    <StackPanel Spacing="14" MaxWidth="1100" Margin="0,0,16,0">
      <TextBlock Classes="PageTitle" Text="{l10n:Localize Key=Results.Title}" />

      <TextBlock Text="{l10n:Localize Key=Results.NoData}"
                 Classes="Muted"
                 IsVisible="{Binding !HasResults}" />

      <StackPanel Spacing="14" IsVisible="{Binding HasResults}">

        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <Border Grid.Column="0" Classes="Card" IsVisible="{Binding PrimaryPick, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="10" DataContext="{Binding PrimaryPick}" x:DataType="vm:ResolverPickViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="Badge Accent">
                  <TextBlock Text="{l10n:Localize Key=Results.Recommendation.Primary}" />
                </Border>
                <Border Classes="Badge" IsVisible="{Binding NoLogs}">
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.NoLogs}" />
                </Border>
                <Border Classes="Badge" IsVisible="{Binding SupportsDnssec}">
                  <TextBlock Text="DNSSEC" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Provider}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Endpoint}" Classes="Muted" FontSize="14" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="14">
                <StackPanel>
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.Avg}" Classes="Caption" />
                  <TextBlock Text="{Binding AverageDisplay}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.Protocol}" Classes="Caption" />
                  <TextBlock Text="{Binding Protocol}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel IsVisible="{Binding CountryCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.Region}" Classes="Caption" />
                  <TextBlock Text="{Binding CountryCode}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="Card" IsVisible="{Binding SecondaryPick, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="10" DataContext="{Binding SecondaryPick}" x:DataType="vm:ResolverPickViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="Badge">
                  <TextBlock Text="{l10n:Localize Key=Results.Recommendation.Secondary}" />
                </Border>
                <Border Classes="Badge" IsVisible="{Binding NoLogs}">
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.NoLogs}" />
                </Border>
                <Border Classes="Badge" IsVisible="{Binding SupportsDnssec}">
                  <TextBlock Text="DNSSEC" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Provider}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Endpoint}" Classes="Muted" FontSize="14" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="14">
                <StackPanel>
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.Avg}" Classes="Caption" />
                  <TextBlock Text="{Binding AverageDisplay}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.Protocol}" Classes="Caption" />
                  <TextBlock Text="{Binding Protocol}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel IsVisible="{Binding CountryCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{l10n:Localize Key=Resolvers.Column.Region}" Classes="Caption" />
                  <TextBlock Text="{Binding CountryCode}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="CardSecondary">
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0">
              <TextBlock Text="Tested" Classes="Caption" />
              <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{l10n:Localize Key=Status.Alive}" Classes="Caption" />
              <TextBlock Text="{Binding AliveCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="DNSSEC" Classes="Caption" />
              <TextBlock Text="{Binding DnssecCount}" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="{l10n:Localize Key=Status.Redirecting}" Classes="Caption" />
              <TextBlock Text="{Binding RedirectingCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{l10n:Localize Key=Results.ExportCsv}" Command="{Binding ExportCsvCommand}" />
          <Button Content="{l10n:Localize Key=Results.ExportJson}" Command="{Binding ExportJsonCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding ExportStatus}" Classes="Caption"
                   IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="GroupHeader" Text="All resolvers" />

        <Border Classes="CardSecondary">
          <Grid ColumnDefinitions="Auto,180,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sort by" VerticalAlignment="Center" Classes="Caption" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding AvailableSortModes}"
                      SelectedItem="{Binding SortMode, Mode=TwoWay}" />
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" ItemSpacing="14" ItemHeight="32">
              <CheckBox Content="Hide dead" IsChecked="{Binding HideDead, Mode=TwoWay}" />
              <CheckBox Content="Hide redirecting" IsChecked="{Binding HideRedirecting, Mode=TwoWay}" />
              <CheckBox Content="DNSSEC only" IsChecked="{Binding DnssecOnly, Mode=TwoWay}" />
              <CheckBox Content="Hide poisoned" IsChecked="{Binding HidePoisoned, Mode=TwoWay}" />
            </WrapPanel>
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="20" Margin="2,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource BarCachedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Cached" Classes="Caption" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource BarUncachedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Uncached" Classes="Caption" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource BarDotComBrush}" VerticalAlignment="Center" />
            <TextBlock Text="DotCom" Classes="Caption" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResolverRowViewModel">
              <Border Classes="SettingRow ResultRow">
                <Grid ColumnDefinitions="Auto,2*,3*,Auto,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                  <Border Grid.Column="0"
                          Classes="StatusDot"
                          Classes.Healthy="{Binding IsHealthy}"
                          Classes.Warning="{Binding IsRedirecting}"
                          Classes.Critical="{Binding IsDead}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Endpoint}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3" ToolTip.Placement="Top">
                    <ToolTip.Tip>
                      <StackPanel Spacing="6" Margin="2">
                        <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,60" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="3">
                          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="7">
                            <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BarCachedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Cached" />
                          </StackPanel>
                          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CachedDisplay}" TextAlignment="Right" />
                          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="7">
                            <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BarUncachedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Uncached" />
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UncachedDisplay}" TextAlignment="Right" />
                          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="7">
                            <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BarDotComBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="DotCom" />
                          </StackPanel>
                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DotComDisplay}" TextAlignment="Right" />
                          <TextBlock Grid.Row="3" Grid.Column="0" Text="Average" Classes="Caption" VerticalAlignment="Center" />
                          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AverageDisplay}" TextAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                      </StackPanel>
                    </ToolTip.Tip>

                    <Grid>
                      <Border Height="5" HorizontalAlignment="Stretch" CornerRadius="2.5" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      <Border Classes="MetricBar" Height="5" HorizontalAlignment="Left" CornerRadius="2.5"
                              Background="{DynamicResource BarCachedBrush}"
                              Width="{Binding CachedFraction, Converter={x:Static vm:FractionToWidthConverter.Default}, ConverterParameter=260}" />
                    </Grid>
                    <Grid>
                      <Border Height="5" HorizontalAlignment="Stretch" CornerRadius="2.5" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      <Border Classes="MetricBar" Height="5" HorizontalAlignment="Left" CornerRadius="2.5"
                              Background="{DynamicResource BarUncachedBrush}"
                              Width="{Binding UncachedFraction, Converter={x:Static vm:FractionToWidthConverter.Default}, ConverterParameter=260}" />
                    </Grid>
                    <Grid>
                      <Border Height="5" HorizontalAlignment="Stretch" CornerRadius="2.5" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      <Border Classes="MetricBar" Height="5" HorizontalAlignment="Left" CornerRadius="2.5"
                              Background="{DynamicResource BarDotComBrush}"
                              Width="{Binding DotComFraction, Converter={x:Static vm:FractionToWidthConverter.Default}, ConverterParameter=260}" />
                    </Grid>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding AverageDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />
                  <Border Grid.Column="4" Classes="Badge" IsVisible="{Binding SupportsDnssec}" VerticalAlignment="Center">
                    <TextBlock Text="DNSSEC" />
                  </Border>
                  <Button Grid.Column="5"
                          Content="{l10n:Localize Key=Common.Apply}"
                          Command="{Binding ((vm:ResultsPageViewModel)DataContext).ApplyRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding .}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
