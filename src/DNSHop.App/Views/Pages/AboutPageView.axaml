<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l10n="using:DNSHop.App.Localization"
             xmlns:vm="using:DNSHop.App.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="DNSHop.App.Views.Pages.AboutPageView"
             x:DataType="vm:AboutPageViewModel"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" MaxWidth="1000" HorizontalAlignment="Stretch" Margin="0,0,40,0">
      <TextBlock Classes="PageTitle" Text="{l10n:Localize Key=About.Title}" />

      <Border Classes="Card">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
          <Border Grid.Column="0" Width="96" Height="96" CornerRadius="16"
                  Background="{DynamicResource SubtleFillColorTertiaryBrush}">
            <Image Source="/Assets/DNSHopMark.png" Stretch="Uniform" Margin="8" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{l10n:Localize Key=App.Title}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Classes="Muted" />
            <TextBlock Text="{l10n:Localize Key=About.Tagline}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <ui:SettingsExpander Header="{l10n:Localize Key=About.Repository}" IconSource="Globe">
        <ui:SettingsExpander.Footer>
          <Button Content="{l10n:Localize Key=About.Repository}" Command="{Binding OpenRepositoryCommand}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="{l10n:Localize Key=About.Issues}" IconSource="Message">
        <ui:SettingsExpander.Footer>
          <Button Content="{l10n:Localize Key=About.Issues}" Command="{Binding OpenIssuesCommand}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Discord" IconSource="People">
        <ui:SettingsExpander.Footer>
          <Button Content="Open Discord" Command="{Binding OpenDiscordCommand}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Ko-fi">
        <ui:SettingsExpander.IconSource>
          <ui:PathIconSource Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                             Foreground="#FF5E5B" />
        </ui:SettingsExpander.IconSource>
        <ui:SettingsExpander.Footer>
          <Button Content="Open Ko-fi" Command="{Binding OpenKoFiCommand}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Telegram">
        <ui:SettingsExpander.IconSource>
          <ui:PathIconSource Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.139-5.061 3.345-.479.329-.913.489-1.302.481-.428-.009-1.252-.242-1.865-.442-.751-.244-1.349-.374-1.297-.788.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                             Foreground="#229ED9" />
        </ui:SettingsExpander.IconSource>
        <ui:SettingsExpander.Footer>
          <Button Content="Open Telegram" Command="{Binding OpenTelegramCommand}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <Border Classes="Card">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <Viewbox Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
            <Canvas Width="32" Height="32">
              <Ellipse Width="32" Height="32" Fill="#F7931A" />
              <Path Fill="White"
                    Data="M 23.189 14.02 c .314 -2.096 -1.283 -3.223 -3.465 -3.975 l .708 -2.84 -1.728 -.43 -.69 2.765 c -.454 -.114 -.92 -.22 -1.385 -.326 l .695 -2.783 L 15.596 6 l -.708 2.839 c -.376 -.086 -.745 -.17 -1.103 -.26 l .002 -.009 -2.384 -.595 -.46 1.846 s 1.283 .294 1.256 .312 c .7 .175 .826 .638 .805 1.006 l -.806 3.235 c .048 .012 .11 .03 .18 .057 l -.183 -.045 -1.13 4.532 c -.086 .212 -.303 .531 -.793 .41 .018 .025 -1.256 -.313 -1.256 -.313 l -.858 1.978 2.25 .561 c .418 .105 .828 .215 1.231 .318 l -.715 2.872 1.727 .43 .708 -2.84 c .472 .127 .93 .245 1.378 .357 l -.706 2.828 1.728 .43 .715 -2.866 c 2.948 .558 5.164 .333 6.097 -2.333 .752 -2.146 -.037 -3.385 -1.588 -4.192 1.13 -.26 1.98 -1.003 2.207 -2.538 z m -3.95 5.538 c -.533 2.147 -4.148 .986 -5.32 .695 l .95 -3.805 c 1.172 .293 4.929 .872 4.37 3.11 z m .535 -5.569 c -.487 1.953 -3.495 .96 -4.47 .717 l .86 -3.45 c .975 .243 4.118 .696 3.61 2.733 z" />
            </Canvas>
          </Viewbox>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="Donate (Bitcoin)" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding DonationAddress}" Classes="Muted"
                                 FontSize="12" FontFamily="Consolas, Menlo, monospace"
                                 TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Content="Copy address" VerticalAlignment="Center"
                  Command="{Binding CopyDonationAddressCommand}" />
        </Grid>
      </Border>

      <Border Classes="Card">
        <TextBlock Text="{l10n:Localize Key=About.Credits}" Classes="Muted" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
